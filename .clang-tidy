Checks: >-
    -*,
    bugprone-*,
    cert-*,
    clang-analyzer-*,
    concurrency-*,
    misc-*,
    performance-*,
    portability-*,
    readability-*,
    -readability-implicit-bool-conversion,
    -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
WarningsAsErrors: '*'
HeaderFilterRegex: '.*common/scanner\.h'
