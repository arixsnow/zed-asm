#!/bin/sh
# SPDX-License-Identifier: MIT

set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
tag=$(sha256sum "${root}/Containerfile" | cut -c1-12)
image="localhost/zed-asm-dev:${tag}"

if [ "${1:-}" = --image ]; then
    printf '%s\n' "${image}"
    exit 0
fi

sources=
if [ "${1:-}" = --sources ]; then
    if [ "$#" -lt 2 ]; then
        printf 'usage: %s --sources DIR [COMMAND...]\n' "$0" >&2
        exit 2
    fi
    sources=$(CDPATH='' cd -- "$2" && pwd)
    shift 2
fi

if ! podman image exists "${image}"; then
    podman build --target dev --tag "${image}" --file "${root}/Containerfile" "${root}"
fi

tty=false
if [ -t 0 ] && [ -t 1 ]; then
    tty=true
fi
if [ "$#" -eq 0 ]; then
    set -- bash
fi
if [ -n "${sources}" ]; then
    set -- --security-opt label=disable --volume "${sources}:/sources:ro" "${image}" "$@"
else
    set -- "${image}" "$@"
fi

exec podman run --rm --interactive --tty="${tty}" \
    --userns=keep-id \
    --network=none \
    --volume "${root}:/work:Z" \
    --volume zed-asm-cache:/cache:U \
    --env HOME=/cache \
    --env XDG_CACHE_HOME=/cache \
    --workdir /work \
    "$@"
